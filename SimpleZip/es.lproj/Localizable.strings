"welcome.language.title" = "Elige el idioma de la interfaz";
"welcome.language.body" = "El idioma de la interfaz de la app es independiente del idioma del sistema. El cambio se aplica al instante; la barra de menús de macOS se actualiza tras reiniciar.";
"welcome.startupLocation.title" = "Qué abrir al iniciar SimpleZip";
"welcome.startupLocation.body" = "SimpleZip abrirá esta ubicación automáticamente al iniciar. Para usar una carpeta personalizada, selecciónala más tarde en Ajustes.";
"welcome.overwrite.title" = "Qué hacer si un archivo ya existe";
"welcome.overwrite.body" = "Este comportamiento predeterminado indica a SimpleZip cómo gestionar conflictos de nombres durante la extracción.";
"welcome.presetPassword.title" = "Contraseña predefinida (opcional)";
"welcome.presetPassword.body" = "Cuando está activado, SimpleZip prueba silenciosamente la contraseña que guardaste en el llavero de macOS. Añade la contraseña más tarde en Ajustes → General, donde Touch ID puede mostrar el texto sin cifrar.";
"welcome.finderAutoExtract.title" = "Extraer automáticamente desde Finder (opcional)";
"welcome.finderAutoExtract.body" = "Cuando está activado, hacer doble clic en un archivo comprimido en el Finder lo extrae directamente en su carpeta en vez de abrir el navegador; y un archivo que encuentres dentro de un comprimido en Spotlight extrae solo ese archivo. Los DMG y otros formatos que requieren montaje siguen el flujo de exploración.";
"welcome.safety.title" = "Política de seguridad";
"welcome.safety.body" = "El contenido de los archivos comprimidos no es de confianza. De forma predeterminada, SimpleZip pregunta antes de cualquiera de las tres acciones siguientes. Puedes ajustar cada regla más tarde en Ajustes → Seguridad.";
