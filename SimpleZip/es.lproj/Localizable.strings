"welcome.language.title" = "Elige el idioma de la interfaz";
"welcome.language.body" = "El idioma de la interfaz de la app es independiente del idioma del sistema. El cambio se aplica al instante; la barra de menús de macOS se actualiza tras reiniciar.";
"welcome.startupLocation.title" = "Qué abrir al iniciar SimpleZip";
