/* Help center categories and topics */
"help.category.basics" = "Conceptos básicos";
"help.category.verify" = "Verificar y publicar";
"help.category.analyze" = "Herramientas de análisis";
"help.category.safety" = "Seguridad y metadatos";
"help.category.automation" = "Automatización y tareas";
"help.topic.checksums.title" = "Hashes y archivos de suma de verificación";
"help.topic.checksums.body" = "• Clic derecho → Sumas de verificación: calcula todos los hashes a la vez, o CRC32/MD5/SHA1/SHA256/SHA512 por separado.\n• \"Generar SHA256SUMS\" escribe un archivo compatible con GNU junto a tus archivos; los destinatarios verifican con sha256sum -c.\n• Selecciona un archivo de suma como SHA256SUMS y elige Verificar para comprobar cada línea.";
"help.topic.inspect.title" = "Inspección de publicación y huella estructural";
"help.topic.inspect.body" = "• Clic derecho en un archivo → Herramientas de archivo → Inspección de publicación: prueba de integridad, rutas sospechosas, basura, carpetas vacías y SHA-256 en un solo informe.\n• Al inspeccionar una .app se comprueban Info.plist, firma de código y Gatekeeper; los DMG revisan el diseño de instalación por arrastre; los XIP informan la confianza de la firma.\n• La huella estructural mira solo la estructura de entradas; al volver a empaquetar se mantiene estable, así puedes saber si dos archivos contienen lo mismo.";
"help.topic.release.title" = "Asistente de publicación y preajustes de espacio de trabajo";
"help.topic.release.body" = "• Herramientas → Asistente de publicación: empaquetar (reproducible, sin basura) → inspeccionar → SHA256SUMS → firma opcional, todo en un flujo.\n• Los preajustes de espacio de trabajo guardan una configuración de publicación completa con un nombre; la próxima vez que publiques ese proyecto basta un clic.\n• El diálogo de creación incluye un botón \"Usar Asistente de publicación\" que conserva lo que ya escribiste.";
"help.topic.analyze.title" = "Análisis de espacio y búsqueda de duplicados";
"help.topic.analyze.body" = "• Clic derecho en un archivo → Análisis de espacio: archivos más grandes, desglose por carpeta y extensión, relación de compresión.\n• Clic derecho en el área vacía de una carpeta → Buscar archivos sospechosamente duplicados: agrupa por huella estructural, incluso entre formatos.\n• Dentro de un archivo abierto, Buscar contenido de archivos revisa solo textos, en un área temporal que se borra justo después.";
"help.topic.presets.title" = "Extracción y conversión por lotes";
"help.topic.presets.body" = "• El menú Aplicar preajuste del diálogo de extracción rellena tres escenarios con un clic: extracción limpia / cautelosa / extraer y ordenar.\n• La conversión admite una carpeta de salida unificada, omitir cuando sea idéntico, reintento automático y prueba posterior.\n• ¿Falta un volumen? Clic derecho en cualquier volumen → Buscar volúmenes faltantes: elige una carpeta, las partes encontradas se copian de vuelta y un conjunto completo se combina y prueba automáticamente.";
"help.topic.safety.title" = "Informe de seguridad y autocomprobación";
"help.topic.safety.body" = "• Al abrir un archivo con rutas sospechosas se muestra un aviso; el informe de seguridad lista cada familia (escapes, letras de unidad, colisiones de mayúsculas/minúsculas, caracteres invisibles…).\n• La extracción siempre aterriza primero en un área de preparación; los archivos que ya están en el destino nunca se tocan.\n• La biblioteca de autocomprobación de las herramientas de desarrollador ejecuta 15 muestras hostiles contra los backends reales: una última revisión física antes de cada publicación.";
"help.topic.cli.title" = "CLI y automatización por URL";
"help.topic.cli.body" = "• Instala el comando simplezip en Ajustes → General: check / compare / create --template / verify / open, con resultados en el Centro de actividad.\n• Otras apps pueden pedir acciones con URLs como simplezip://check?path=…; siempre aparece primero un diálogo de confirmación.\n• Los servicios de clic derecho del Finder (comprimir / extraer / hash) se activan individualmente en Ajustes → General.";

