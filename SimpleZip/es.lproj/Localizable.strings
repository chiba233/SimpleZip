"settings.formatMatrix.backend.zip" = "Motor: 7-Zip incluido (7zz), con unzip del sistema como respaldo";
"settings.formatMatrix.detail.zip" = "Capacidad completa: crear, extraer, editar entradas, cifrado AES-256, volúmenes y comentario de archivo editable. Los nombres de archivo nunca se cifran: el formato ZIP no tiene cifrado de cabecera.";
"settings.formatMatrix.backend.7z" = "Motor: 7-Zip incluido (7zz)";
"settings.formatMatrix.detail.7z" = "Compresión máxima con cifrado de cabecera (oculta los nombres de archivo). El propio formato 7z no tiene campo de comentario de archivo, por eso la columna de comentario está vacía.";
"settings.formatMatrix.backend.rar" = "Motor: extracción mediante 7zz incluido; crear requiere la herramienta rar de RARLAB (instalada por el usuario)";
"settings.formatMatrix.detail.rar" = "RAR es un formato propietario: 7-Zip solo implementa su lectura. Crear archivos RAR requiere la herramienta de línea de comandos con licencia de RARLAB; instálala y la opción aparecerá automáticamente.";
"settings.formatMatrix.backend.tar" = "Motor: tar del sistema + 7zz incluido";
"settings.formatMatrix.detail.tar" = "tar empaqueta sin comprimir y conserva fielmente permisos Unix y enlaces simbólicos. El formato no tiene campo de cifrado: envuélvelo (por ejemplo, cifra a .gpg) o usa 7z/ZIP si necesitas contraseña.";
"settings.formatMatrix.backend.tgz" = "Motor: tar del sistema + gzip";
"settings.formatMatrix.detail.tgz" = "Un tar comprimido con gzip: la misma semántica Unix fiel que tar, y sigue sin campo de cifrado en el formato.";
"settings.formatMatrix.backend.dmg" = "Motor: hdiutil del sistema";
"settings.formatMatrix.detail.dmg" = "Imagen de disco de Apple. Al explorar se monta en solo lectura (las imágenes no confiables se montan con propiedad desactivada). SimpleZip no crea DMG cifrados, volúmenes ni comentarios.";
"settings.formatMatrix.backend.xip" = "Motor: herramienta xip del sistema de Apple (extracción) + 7zz (exploración del contenedor xar)";
"settings.formatMatrix.detail.xip" = "Archivo firmado por Apple (distribución de Xcode). La extracción pasa por la herramienta de Apple, que verifica la firma. Crear XIP requiere un certificado de firma de Apple, por eso no se ofrece.";
"settings.formatMatrix.detail.zst" = "Zstandard es de solo lectura aquí. El 7-Zip incluido lista, extrae y prueba tanto .zst como .tar.zst (una tubería de dos capas, como .tar.gz), pero no trae ningún codificador zstd y bsdtar de macOS tampoco tiene ninguno — así que SimpleZip los abre pero no puede crearlos.";
"settings.formatMatrix.detail.iso" = "Las imágenes de disco ISO y UDF son de solo lectura. El 7-Zip incluido las lista, extrae y prueba; no hay escritura, cifrado ni comentarios — son imágenes contenedor, no archivos que puedas editar.";
"settings.formatMatrix.detail.cab" = "Microsoft Cabinet (.cab) es de solo lectura. El 7-Zip incluido lo extrae y prueba; SimpleZip no crea ni edita cabinets.";
"settings.formatMatrix.detail.cpio" = "El formato de archivo cpio es de solo lectura aquí. El 7-Zip incluido lo extrae y prueba; SimpleZip no crea ni edita archivos cpio.";
"settings.formatMatrix.detail.xar" = "XAR y su variante de instalador .pkg son de solo lectura. El 7-Zip incluido lista, extrae y prueba el contenedor xar; SimpleZip no construye ni firma instaladores.";
"settings.formatMatrix.backend.gpg" = "Motor: GnuPG (instalado por el usuario)";
"settings.formatMatrix.detail.gpg" = "Contenedor cifrado OpenPGP: cifrar es “crear”, descifrar es “abrir”. Envuelve un único flujo: no hay estructura de entradas que editar, dividir o comentar.";
"settings.formatMatrix.backend.siz" = "Motor: SimpleZip (envoltorio tar) + GnuPG";
"settings.formatMatrix.detail.siz" = "Contenedor firmado de SimpleZip: un archivo interno más una firma separada y metadatos, opcionalmente cifrado para destinatarios. Editar rompería la firma, por eso las entradas son de solo lectura; Probar significa verificar la firma.";
