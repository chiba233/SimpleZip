"welcome.intro.title" = "几步搞定关键设置";
"welcome.intro.body" = "SimpleZip 是一个原生 macOS 压缩包管理器。下面这几步会帮你打开几个新用户最容易错过的开关。你随时能在 SimpleZip → 重新运行欢迎助手 里再次打开本向导。";
"welcome.intro.note" = "所有设置都可以在「SimpleZip → 偏好设置」里随时修改。";
"welcome.language.title" = "选择界面语言";
"welcome.language.body" = "界面语言独立于系统语言。改语言会即时生效；macOS 顶部菜单栏要重启 App 后才会跟随。";
"welcome.startupLocation.title" = "启动时打开哪个位置";
"welcome.startupLocation.body" = "下次启动 SimpleZip 时，自动打开你选的位置。如果你想用自定义路径，可以稍后在偏好设置里挑文件夹。";
"welcome.overwrite.title" = "解压遇到同名文件时怎么办";
"welcome.overwrite.body" = "默认覆盖行为决定 SimpleZip 解压时碰到已存在的同名文件该如何处理。";
"welcome.presetPassword.title" = "预设密码（可选）";
"welcome.presetPassword.body" = "启用后，SimpleZip 会用你保存在 Mac 钥匙串里的密码自动尝试解压。可以稍后在「偏好设置 → 通用」里填入密码或用 Touch ID 显示明文。";
"welcome.finderAutoExtract.title" = "Finder 双击自动解压（可选）";
"welcome.finderAutoExtract.body" = "开启后，从 Finder 双击压缩包会直接解压到所在目录，不再打开浏览窗口。DMG 等需要挂载的格式仍走原浏览路径。";
"welcome.fileAssociations.title" = "用 SimpleZip 打开压缩包";
"welcome.fileAssociations.body" = "把常见压缩格式的默认应用设为 SimpleZip，从 Finder 双击它们就用 SimpleZip 打开。可以一键全设，也可以在下面挑单个格式。";
"welcome.fileAssociations.setAll" = "全部用 SimpleZip 打开";
"welcome.fileAssociations.setAllDone" = "已把所有支持的压缩格式默认应用设为 SimpleZip。";
"welcome.fileAssociations.setAllPartial" = "已设为默认，除了：%@";
"welcome.hiddenFiles.title" = "隐藏文件";
"welcome.hiddenFiles.body" = "在浏览器里显示隐藏文件。开启后它们会收进一个可折叠的「隐藏文件」分组，不糊在列表里 —— 选择什么算隐藏、以及这个分组怎么记忆折叠状态。";
"welcome.rowDensity.title" = "列表大小";
"welcome.rowDensity.body" = "列表行有多高，图标和文字大小随之缩放。文件浏览和压缩包浏览都生效。";
"welcome.grouping.title" = "分组（可选）";
"welcome.grouping.body" = "可选：把浏览列表切成可折叠的区块。设一个全局默认，或者按文件夹记忆分组（之后在文件夹里右键单独设）。保持「无」就是平铺列表。";
"welcome.safety.title" = "安全策略";
"welcome.safety.body" = "压缩包内容是不可信输入。SimpleZip 默认会在以下三种情况之前先弹窗征求你的同意。这些规则可以在「偏好设置 → 安全」里逐项调整。";
"welcome.safety.suspiciousPath" = "可疑路径（路径穿越 / 绝对路径 / Windows 盘符 / UNC）";
