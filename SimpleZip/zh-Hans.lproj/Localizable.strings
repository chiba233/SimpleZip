"welcome.safety.currentValue" = "当前：%@";
"welcome.backend.title" = "后端可用性";
"welcome.backend.body" = "SimpleZip 把所有真正的压缩 / 解压工作交给命令行后端。建议至少有 7-Zip 可用；RAR 只有创建 .rar 时才用得到。";
