"settings.formatMatrix.backend.zip" = "Moteur : 7-Zip intégré (7zz), avec unzip du système en repli";
"settings.formatMatrix.detail.zip" = "Fonctionnalité complète : création, extraction, modification d’entrées, chiffrement AES-256, volumes et commentaire d’archive modifiable. Les noms de fichiers ne sont jamais chiffrés — le format ZIP n’a pas de chiffrement d’en-tête.";
"settings.formatMatrix.backend.7z" = "Moteur : 7-Zip intégré (7zz)";
"settings.formatMatrix.detail.7z" = "Compression la plus forte avec chiffrement d’en-tête (masque les noms de fichiers). Le format 7z n’a pas de champ de commentaire d’archive, d’où la colonne vide.";
"settings.formatMatrix.backend.rar" = "Moteur : extraction via 7zz intégré ; création avec l’outil rar de RARLAB (installé par l’utilisateur)";
"settings.formatMatrix.detail.rar" = "RAR est un format propriétaire — 7-Zip ne sait que le lire. Créer des archives RAR nécessite l’outil en ligne de commande sous licence de RARLAB ; installez-le et l’option apparaîtra automatiquement.";
"settings.formatMatrix.backend.tar" = "Moteur : tar du système + 7zz intégré";
"settings.formatMatrix.detail.tar" = "tar emballe sans compresser et préserve fidèlement les permissions Unix et les liens symboliques. Le format n’a pas de champ de chiffrement — enveloppez-le (par ex. en .gpg) ou utilisez 7z/ZIP si vous avez besoin d’un mot de passe.";
"settings.formatMatrix.backend.tgz" = "Moteur : tar du système + gzip";
"settings.formatMatrix.detail.tgz" = "Un tar compressé avec gzip : mêmes sémantiques Unix fidèles que tar, toujours aucun champ de chiffrement dans le format.";
"settings.formatMatrix.backend.dmg" = "Moteur : hdiutil du système";
"settings.formatMatrix.detail.dmg" = "Image disque Apple. La navigation la monte en lecture seule (les images non fiables sont montées avec la propriété désactivée). SimpleZip ne crée pas de DMG chiffrés, de volumes ni de commentaires.";
"settings.formatMatrix.backend.xip" = "Moteur : outil système xip d’Apple (extraction) + 7zz (navigation dans le conteneur xar)";
"settings.formatMatrix.detail.xip" = "Archive signée par Apple (distribution Xcode). L’extraction passe par l’outil d’Apple, qui vérifie la signature. Créer des XIP nécessite un certificat de signature Apple, donc l’option n’est pas proposée.";
"settings.formatMatrix.detail.zst" = "Zstandard est en lecture seule ici. Le 7-Zip intégré liste, extrait et teste à la fois .zst et .tar.zst (un tube à deux couches comme .tar.gz), mais il n’embarque aucun encodeur zstd et le bsdtar de macOS n’en a pas non plus — SimpleZip les ouvre donc, mais ne peut pas les créer.";
"settings.formatMatrix.detail.iso" = "Les images disque ISO et UDF sont en lecture seule. Le 7-Zip intégré les liste, les extrait et les teste ; il n’y a ni écriture, ni chiffrement, ni commentaire — ce sont des images de conteneur, pas des archives que l’on modifie.";
"settings.formatMatrix.detail.cab" = "Microsoft Cabinet (.cab) est en lecture seule. Le 7-Zip intégré l’extrait et le teste ; SimpleZip ne crée ni ne modifie de cabinets.";
"settings.formatMatrix.detail.cpio" = "Le format d’archive cpio est en lecture seule ici. Le 7-Zip intégré l’extrait et le teste ; SimpleZip ne crée ni ne modifie d’archives cpio.";
"settings.formatMatrix.detail.xar" = "XAR et sa variante d’installateur .pkg sont en lecture seule. Le 7-Zip intégré liste, extrait et teste le conteneur xar ; SimpleZip ne construit ni ne signe d’installateurs.";
"settings.formatMatrix.backend.gpg" = "Moteur : GnuPG (installé par l’utilisateur)";
"settings.formatMatrix.detail.gpg" = "Conteneur chiffré OpenPGP : chiffrer revient à « créer », déchiffrer à « ouvrir ». Il enveloppe un seul flux — aucune structure d’entrées à modifier, fractionner ou commenter.";
"settings.formatMatrix.backend.siz" = "Moteur : SimpleZip (enveloppe tar) + GnuPG";
"settings.formatMatrix.detail.siz" = "Conteneur signé de SimpleZip : une archive interne avec signature détachée et métadonnées, éventuellement chiffrée pour des destinataires. La modification casserait la signature, les entrées sont donc en lecture seule ; Tester signifie vérifier la signature.";
"settings.formatMatrix.backend.szs" = "Moteur : SimpleZip + GnuPG";
