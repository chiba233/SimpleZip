"welcome.backend.title" = "Backend-Verfügbarkeit";
"welcome.backend.body" = "SimpleZip übergibt die eigentliche Archivarbeit an Kommandozeilen-Backends. 7-Zip sollte mindestens verfügbar sein; RAR wird nur zum Erstellen von .rar-Archiven benötigt.";
