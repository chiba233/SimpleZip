"settings.formatMatrix.rowHelp" = "Für Details klicken";
"settings.formatMatrix.backend.zip" = "Backend: mitgelieferte 7-Zip-Engine (7zz), mit systemeigenem unzip als Fallback";
"settings.formatMatrix.detail.zip" = "Volle Funktionen: erstellen, extrahieren, Einträge bearbeiten, AES-256-Verschlüsselung, Volumes und bearbeitbarer Archivkommentar. Dateinamen werden nie verschlüsselt — das ZIP-Format hat keine Header-Verschlüsselung.";
"settings.formatMatrix.backend.7z" = "Backend: mitgelieferte 7-Zip-Engine (7zz)";
"settings.formatMatrix.detail.7z" = "Stärkste Kompression plus Header-Verschlüsselung (versteckt Dateinamen). Das 7z-Format selbst hat kein Feld für Archivkommentare, deshalb ist die Kommentarspalte leer.";
"settings.formatMatrix.backend.rar" = "Backend: Extraktion über mitgeliefertes 7zz; Erstellung benötigt RARLABs rar-Werkzeug (vom Benutzer installiert)";
"settings.formatMatrix.detail.rar" = "RAR ist ein proprietäres Format — 7-Zip kann es nur lesen. Zum Erstellen von RAR-Archiven ist RARLABs lizenziertes Befehlszeilenwerkzeug nötig; installieren Sie es selbst, dann erscheint die Option automatisch.";
"settings.formatMatrix.backend.tar" = "Backend: systemeigenes tar + mitgeliefertes 7zz";
"settings.formatMatrix.detail.tar" = "tar packt ohne Kompression und erhält Unix-Berechtigungen sowie Symlinks genau. Das Format hat kein Verschlüsselungsfeld — umhüllen Sie es (z. B. als .gpg verschlüsseln) oder verwenden Sie 7z/ZIP, wenn Sie ein Passwort brauchen.";
"settings.formatMatrix.backend.tgz" = "Backend: systemeigenes tar + gzip";
"settings.formatMatrix.detail.tgz" = "Ein gzip-komprimiertes tar: dieselben treuen Unix-Semantiken wie tar, weiterhin ohne Verschlüsselungsfeld im Format.";
"settings.formatMatrix.backend.dmg" = "Backend: systemeigenes hdiutil";
"settings.formatMatrix.detail.dmg" = "Apple-Disk-Image. Beim Durchsuchen wird es schreibgeschützt gemountet (nicht vertrauenswürdige Images mit deaktivierten Besitzrechten). SimpleZip erstellt keine verschlüsselten DMGs, Volumes oder Kommentare.";
"settings.formatMatrix.backend.xip" = "Backend: Apples systemeigenes xip-Werkzeug (Extraktion) + 7zz (Durchsuchen des xar-Containers)";
"settings.formatMatrix.detail.xip" = "Apple-signiertes Archiv (Xcode-Verteilung). Die Extraktion läuft über Apples eigenes Werkzeug, das die Signatur prüft. Zum Erstellen von XIPs ist ein Apple-Signaturzertifikat nötig, daher wird es nicht angeboten.";
"settings.formatMatrix.detail.zst" = "Zstandard ist hier schreibgeschützt. Das mitgelieferte 7-Zip listet, extrahiert und testet sowohl .zst als auch .tar.zst (eine zweischichtige Pipe wie .tar.gz), bringt aber keinen zstd-Encoder mit, und auch macOS bsdtar hat keinen — SimpleZip öffnet diese also, kann sie aber nicht erstellen.";
"settings.formatMatrix.detail.iso" = "ISO- und UDF-Disk-Images sind schreibgeschützt. Das mitgelieferte 7-Zip listet, extrahiert und testet sie; es gibt kein Schreiben, keine Verschlüsselung und keinen Kommentar — es sind Container-Images, keine Archive, die Sie bearbeiten.";
"settings.formatMatrix.detail.cab" = "Microsoft Cabinet (.cab) ist schreibgeschützt. Das mitgelieferte 7-Zip extrahiert und testet es; SimpleZip erstellt oder bearbeitet keine Cabinets.";
"settings.formatMatrix.detail.cpio" = "Das cpio-Archivformat ist hier schreibgeschützt. Das mitgelieferte 7-Zip extrahiert und testet es; SimpleZip erstellt oder bearbeitet keine cpio-Archive.";
"settings.formatMatrix.detail.xar" = "XAR und seine .pkg-Installer-Variante sind schreibgeschützt. Das mitgelieferte 7-Zip listet, extrahiert und testet den XAR-Container; SimpleZip erstellt oder signiert keine Installer.";
"settings.formatMatrix.backend.gpg" = "Backend: GnuPG (vom Benutzer installiert)";
"settings.formatMatrix.detail.gpg" = "OpenPGP-verschlüsselter Container: Verschlüsseln ist „Erstellen“, Entschlüsseln ist „Öffnen“. Er umhüllt einen einzelnen Stream — es gibt keine Eintragsstruktur zum Bearbeiten, Teilen oder Kommentieren.";
"settings.formatMatrix.backend.siz" = "Backend: SimpleZip (tar-Hülle) + GnuPG";
"settings.formatMatrix.detail.siz" = "SimpleZips signierter Container: ein inneres Archiv plus abgetrennte Signatur und Metadaten, optional für Empfänger verschlüsselt. Bearbeiten würde die Signatur brechen, daher sind Einträge schreibgeschützt; Test bedeutet Signaturprüfung.";
"settings.formatMatrix.backend.szs" = "Backend: SimpleZip + GnuPG";
"settings.formatMatrix.detail.szs" = "Ein signiertes Manifest (clearsigned JSON), das die Dateien eines Ordners an Ort und Stelle signiert. Es ist kein Archiv — es gibt nichts zu extrahieren; Öffnen prüft die Signatur und zeigt es virtuell an.";
