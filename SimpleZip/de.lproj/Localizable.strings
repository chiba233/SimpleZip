"welcome.intro.title" = "Die wichtigsten Einstellungen in wenigen Schritten festlegen";
"welcome.intro.body" = "SimpleZip ist ein nativer macOS-Archivmanager. Die nächsten Schritte führen dich durch die Optionen, die neue Benutzer am häufigsten übersehen. Du kannst diesen Assistenten jederzeit über SimpleZip → Willkommensassistent erneut ausführen wiederholen.";
"welcome.intro.note" = "Alle Einstellungen hier können später auch über SimpleZip → Einstellungen geändert werden.";
"welcome.language.title" = "Oberflächensprache auswählen";
"welcome.language.body" = "Die Sprache der App-Oberfläche ist unabhängig von der Systemsprache. Änderungen gelten sofort; die macOS-Menüleiste folgt nach dem nächsten Neustart.";
"welcome.startupLocation.title" = "Was beim Start von SimpleZip geöffnet wird";
"welcome.startupLocation.body" = "SimpleZip öffnet diesen Ort beim Start automatisch. Einen eigenen Ordner kannst du später in den Einstellungen wählen.";
"welcome.overwrite.title" = "Was tun, wenn eine Datei bereits existiert";
"welcome.overwrite.body" = "Dieses Standardverhalten legt fest, wie SimpleZip Namenskonflikte beim Entpacken behandelt.";
"welcome.presetPassword.title" = "Voreingestelltes Passwort (optional)";
"welcome.presetPassword.body" = "Wenn aktiviert, versucht SimpleZip automatisch das Passwort, das du im macOS-Schlüsselbund gespeichert hast. Füge das Passwort später unter Einstellungen → Allgemein hinzu; dort kann Touch ID den Klartext anzeigen.";
"welcome.finderAutoExtract.title" = "Automatisch aus Finder entpacken (optional)";
"welcome.finderAutoExtract.body" = "Wenn aktiviert, entpackt ein Doppelklick auf ein Archiv im Finder direkt in den übergeordneten Ordner, statt das Browserfenster zu öffnen. DMGs und andere Formate, die gemountet werden müssen, nutzen weiterhin den Durchsuchen-Ablauf.";
"welcome.safety.title" = "Sicherheitsrichtlinie";
"welcome.safety.body" = "Archivinhalt ist nicht vertrauenswürdig. Standardmäßig fragt SimpleZip vor den drei unten genannten Aktionen nach. Du kannst jede Regel später unter Einstellungen → Sicherheit anpassen.";
"welcome.safety.suspiciousPath" = "Verdächtige Pfade (Traversal / absolut / Windows-Laufwerk / UNC)";
"welcome.safety.symlink" = "Entpackte symbolische und harte Links";
