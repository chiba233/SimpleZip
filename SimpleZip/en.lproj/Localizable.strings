"welcome.intro.title" = "Get the key settings sorted in a few steps";
"welcome.intro.body" = "SimpleZip is a native macOS archive manager. The next few steps walk you through the switches new users miss most often. You can replay this assistant any time from SimpleZip → Run Welcome Assistant Again.";
"welcome.intro.note" = "Every setting here can also be changed later from SimpleZip → Settings.";
"welcome.language.title" = "Pick the interface language";
"welcome.language.body" = "The app's UI language is independent of the system language. Changing it applies immediately; the macOS top menu bar follows after the next relaunch.";
"welcome.startupLocation.title" = "Where to open when SimpleZip starts";
"welcome.startupLocation.body" = "SimpleZip will open this location automatically on launch. To use a custom folder, pick it later in Settings.";
"welcome.overwrite.title" = "What to do when a file already exists";
