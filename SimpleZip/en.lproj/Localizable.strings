"settings.formatMatrix.backend.xar" = "Backend: bundled 7-Zip engine (7zz) — read-only";
"settings.formatMatrix.detail.gpg" = "OpenPGP encrypted container: encrypting is \"creating\", decrypting is \"opening\". It wraps a single stream — there is no entry structure to edit, split, or comment.";
