"welcome.hiddenFiles.title" = "Hidden files";
"welcome.hiddenFiles.body" = "Show hidden files in the browser. When on, they're tucked into a collapsible \"Hidden Files\" group instead of cluttering the list — choose what counts as hidden and how the group remembers its collapsed state.";
