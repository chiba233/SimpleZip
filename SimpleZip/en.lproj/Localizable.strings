"welcome.intro.title" = "Get the key settings sorted in a few steps";
"welcome.intro.body" = "SimpleZip is a native macOS archive manager. The next few steps walk you through the switches new users miss most often. You can replay this assistant any time from SimpleZip → Run Welcome Assistant Again.";
"welcome.intro.note" = "Every setting here can also be changed later from SimpleZip → Settings.";
"welcome.language.title" = "Pick the interface language";
"welcome.language.body" = "The app's UI language is independent of the system language. Changing it applies immediately; the macOS top menu bar follows after the next relaunch.";
"welcome.startupLocation.title" = "Where to open when SimpleZip starts";
"welcome.startupLocation.body" = "SimpleZip will open this location automatically on launch. To use a custom folder, pick it later in Settings.";
"welcome.overwrite.title" = "What to do when a file already exists";
"welcome.overwrite.body" = "This default overwrite behavior tells SimpleZip how to handle name collisions during extraction.";
"welcome.presetPassword.title" = "Preset password (optional)";
"welcome.presetPassword.body" = "When enabled, SimpleZip silently tries the password you've stored in the macOS Keychain. Add the password later in Settings → General, where Touch ID reveals the plaintext.";
"welcome.finderAutoExtract.title" = "Auto-extract from Finder (optional)";
"welcome.finderAutoExtract.body" = "When enabled, double-clicking an archive in Finder extracts it directly into its parent folder instead of opening the browser window. DMGs and other mount-required formats still go through the browse flow.";
"welcome.fileAssociations.title" = "Open archives with SimpleZip";
"welcome.fileAssociations.body" = "Make SimpleZip the default app for common archive types so double-clicking them in Finder opens SimpleZip. Set them all at once, or pick individual formats below.";
"welcome.fileAssociations.setAll" = "Use SimpleZip for all of these";
"welcome.fileAssociations.setAllDone" = "SimpleZip is now the default for all supported archive types.";
