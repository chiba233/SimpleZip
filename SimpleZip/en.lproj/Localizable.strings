/* 0.4.2 Settings - Help & About panes */
"settings.section.help" = "Help";
"settings.section.about" = "About";
"help.intro" = "Everything in SimpleZip, explained — what each format can do, and how the everyday flows work.";
"help.topics.title" = "How do I…";
"help.category.basics" = "Basics";
"help.category.verify" = "Verify & Release";
"help.category.analyze" = "Analysis Tools";
"help.category.safety" = "Safety & Metadata";
"help.category.automation" = "Automation & Tasks";
"help.topic.checksums.title" = "Hashes & checksum files";
"help.topic.checksums.body" = "• Right-click → Checksums: compute every hash at once, or CRC32/MD5/SHA1/SHA256/SHA512 individually.\n• \"Generate SHA256SUMS\" writes a GNU-compatible checksum file next to your files — recipients verify with sha256sum -c.\n• Select a checksum file like SHA256SUMS and choose Verify to check every line.";
"help.topic.inspect.title" = "Release inspection & structural fingerprint";
"help.topic.inspect.body" = "• Right-click an archive → Archive Tools → Release Inspection: integrity test, suspicious paths, junk, empty folders and SHA-256 in one report.\n• Inspecting a .app checks Info.plist, code signature and Gatekeeper; DMGs check drag-install layout; XIPs report signature trust.\n• The structural fingerprint looks only at entry structure — repacking keeps it stable, so you can tell whether two archives are the same content.";
"help.topic.release.title" = "Release Assistant & workspace presets";
"help.topic.release.body" = "• Tools → Release Assistant: pack (reproducible, junk excluded) → inspect → SHA256SUMS → optional signing, in one flow.\n• Workspace Presets save a whole release setup under a name — one click next time you ship that project.\n• The create dialog has a \"Use Release Assistant\" button that carries over what you already typed.";
"help.topic.analyze.title" = "Space analysis & duplicate hunting";
"help.topic.analyze.body" = "• Right-click an archive → Space Analysis: largest files, folder and extension breakdown, compression ratio.\n• Right-click a folder's empty area → Find Suspected Duplicate Archives: groups by structural fingerprint, even across formats.\n• Inside an open archive, Search File Contents scans text files only, in a temp area deleted right after.";
"help.topic.presets.title" = "Batch extraction & conversion";
"help.topic.presets.body" = "• The extract dialog's Apply Preset menu fills three scenarios in one click: clean unpack / cautious / extract & tidy.\n• Conversion supports a unified output folder, skip-when-identical, automatic retry and post-conversion testing.\n• Missing a volume? Right-click any volume → Search for Missing Volumes: pick a folder, found parts are copied back, a complete set auto-combines and tests.";
"help.topic.safety.title" = "Security report & self-check";
"help.topic.safety.body" = "• Opening an archive with suspicious paths shows a banner; the security report lists each family (escapes, drive letters, case collisions, invisible characters…).\n• Extraction always lands in a staging area first — files already in your destination are never touched.\n• The developer tools' self-check library runs 15 hostile samples against the real backends — a final physical before each release.";
"help.topic.cli.title" = "CLI & URL automation";
"help.topic.cli.body" = "• Install the simplezip command in Settings → General: check / compare / create --template / verify / open, with results in the Activity Center.\n• Other apps can request actions via URLs like simplezip://check?path=… — a confirmation dialog always comes first.\n• Finder right-click services (compress / extract / hash) toggle individually in Settings → General.";
"help.topic.open.title" = "Open & browse archives";
"help.topic.open.body" = "• Double-click any archive — ZIP, 7z, RAR, TAR…, DMG, or xip — to browse it without extracting.\n• Drag an archive into the window, or right-click any file → Open as Archive to force it.\n• Signed .siz / .szs containers verify their signature first, then open like a normal archive.";
"help.topic.extract.title" = "Extract";
"help.topic.extract.body" = "• Right-click → Extract Here, or open the archive and use the Extract button for the full dialog.\n• The dialog shows a pre-flight summary: file count, size, overwrite risk, missing volumes.\n• Encrypted archives ask once — the password is remembered for the rest of the session.\n• .gpg files decrypt right next to the source, never overwriting anything.";
"help.topic.create.title" = "Create archives";
"help.topic.create.body" = "• Select files → Add to Archive. Pick a template (GitHub Release, max-compression 7z, encrypted delivery…) or tune everything by hand.\n• Exclude rules can be previewed: see exactly which files will be skipped before you pack.\n• The dry-run drawer counts files and bytes up front, and warns if the output name already exists.";
"help.topic.edit.title" = "Edit inside an archive";
"help.topic.metadata.title" = "macOS metadata: what survives an archive";
"help.topic.metadata.body" = "• Unix permissions (read/write/execute bits) survive in ZIP, 7z and tar — verified round-trip with the bundled engines.\n• Extended attributes — Finder tags, com.apple.quarantine, resource forks, custom xattrs — are preserved by **tar / tar.gz** (the system tar stores and restores them, quarantine flags included), but **not** by ZIP or 7z created with SimpleZip: the 7-Zip engine doesn't store them.\n• ZIP archives made by Finder's Archive Utility carry mac metadata as __MACOSX / ._AppleDouble entries instead. SimpleZip's \"Clean macOS junk\" removes exactly those entries — handy for cross-platform sharing, but it discards that file's mac metadata on purpose.\n• Modification times are stored everywhere (the reproducible-archive option deliberately drops them); creation dates, access times and ACLs are not guaranteed by any format.\n• Rule of thumb: archives for other Macs → tar.gz keeps everything; archives for the world → ZIP, plus junk cleanup.";
"help.topic.edit.body" = "• Writable ZIP / 7z archives accept drag-in, rename, delete, and batch rename — all staged on a copy and swapped in atomically, so a failure never corrupts the original.\n• Edit the ZIP archive comment from the banner or the blank-area context menu.\n• Quick Look any entry, or save a single entry copy without extracting everything.";
"help.topic.search.title" = "Search, filter & compare";
"help.topic.search.body" = "• The search field understands tokens: *.swift size:>1MB encrypted:true modified:<7d regex:…\n• Save your favorite filters; one-click presets cover encrypted, large, recent, and suspicious paths.\n• Compare two archives — or a folder against an archive — and export the differences as JSON, CSV, or Markdown.\n• Find Duplicate Files groups identical content by size + CRC.";
"help.topic.sign.title" = "Sign & encrypt (GPG)";
"help.topic.sign.body" = "• Turn on GPG in Settings → GPG first — all entry points stay hidden until you do.\n• Wrap an archive into a signed .siz, sign a folder in place with a .szs manifest, or encrypt files to recipients and/or a password.\n• SimpleZip never touches your private-key passphrase: unlocking is always handled by gpg-agent / pinentry.";
"help.topic.tasks.title" = "Activity Center";
"help.topic.tasks.body" = "• Every operation lands here: progress, logs, and the exact backend command (copyable).\n• Finished tasks can be re-run with one click; batch failures offer retry-failed-only.\n• Export a per-task diagnostics report when something goes wrong — passwords are never included.";
