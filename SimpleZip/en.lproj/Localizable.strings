"welcome.hiddenFiles.title" = "Hidden files";
"welcome.hiddenFiles.body" = "Show hidden files in the browser. When on, they're tucked into a collapsible \"Hidden Files\" group instead of cluttering the list — choose what counts as hidden and how the group remembers its collapsed state.";
"welcome.rowDensity.title" = "List size";
"welcome.rowDensity.body" = "How tall list rows are, with matching icon and text sizes. Applies to both the file and archive browsers.";
"welcome.grouping.title" = "Grouping (optional)";
"welcome.grouping.body" = "Optionally split the browser list into collapsible sections. Set a global default, or remember a grouping per folder (then set it via right-click in any folder). Leave as None to keep a flat list.";
"welcome.safety.title" = "Safety policy";
"welcome.safety.body" = "Archive contents are untrusted input. By default SimpleZip prompts you before any of the three things below. You can adjust each rule later in Settings → Security.";
