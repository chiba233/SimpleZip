"welcome.rowDensity.body" = "How tall list rows are, with matching icon and text sizes. Applies to both the file and archive browsers.";
"welcome.grouping.title" = "Grouping (optional)";
"welcome.grouping.body" = "Optionally split the browser list into collapsible sections. Set a global default, or remember a grouping per folder (then set it via right-click in any folder). Leave as None to keep a flat list.";
