          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta una prueba de integridad en varios archivos y devuelve verdadero solo cuando todos la superan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Effectue un test d’intégrité sur plusieurs archives et renvoie vrai uniquement si toutes réussissent."
          }
