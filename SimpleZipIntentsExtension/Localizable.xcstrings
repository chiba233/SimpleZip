          }
        }
      }
    },
    "Runs an integrity test across several archives and returns true only when every archive passes." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt einen Integritätstest über mehrere Archive aus und gibt nur dann „wahr“ zurück, wenn alle bestehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
