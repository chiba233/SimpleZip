    "Verifies the files listed in checksum files (SHA256SUMS, .sha256, .md5, .sfv). Paths resolve relative to each checksum file; unsafe entries are rejected. Returns true when everything matches." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüft die in Prüfsummendateien aufgeführten Dateien (SHA256SUMS, .sha256, .md5, .sfv). Pfade werden relativ zur jeweiligen Prüfsummendatei aufgelöst; unsichere Einträge werden abgelehnt. Gibt „wahr“ zurück, wenn alles übereinstimmt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifies the files listed in checksum files (SHA256SUMS, .sha256, .md5, .sfv). Paths resolve relative to each checksum file; unsafe entries are rejected. Returns true when everything matches."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifica los archivos listados en archivos de sumas (SHA256SUMS, .sha256, .md5, .sfv). Las rutas se resuelven relativas a cada archivo de sumas; las entradas no seguras se rechazan. Devuelve verdadero cuando todo coincide."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifie les fichiers listés dans les fichiers de sommes (SHA256SUMS, .sha256, .md5, .sfv). Les chemins sont résolus par rapport à chaque fichier de sommes ; les entrées dangereuses sont rejetées. Renvoie vrai si tout correspond."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "チェックサムファイル(SHA256SUMS、.sha256、.md5、.sfv)に記載されたファイルを検証します。パスは各チェックサムファイルからの相対で解決し、危険なエントリは拒否します。すべて一致すれば true を返します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "체크섬 파일(SHA256SUMS, .sha256, .md5, .sfv)에 나열된 파일을 검증합니다. 경로는 각 체크섬 파일을 기준으로 해석하며 안전하지 않은 항목은 거부합니다. 모두 일치하면 true를 반환합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверяет файлы, перечисленные в файлах контрольных сумм (SHA256SUMS, .sha256, .md5, .sfv). Пути разрешаются относительно каждого файла сумм; небезопасные записи отклоняются. Возвращает true, если всё совпадает."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจสอบไฟล์ที่ระบุในไฟล์เช็คซัม (SHA256SUMS, .sha256, .md5, .sfv) เส้นทางอ้างอิงสัมพัทธ์กับไฟล์เช็คซัมแต่ละไฟล์ และปฏิเสธรายการที่ไม่ปลอดภัย คืนค่า true เมื่อทุกอย่างตรงกัน"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "校验校验文件(SHA256SUMS、.sha256、.md5、.sfv)里列出的文件。路径相对各自的校验文件解析;不安全的条目会被拒绝。全部匹配时返回真。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "校驗校驗檔(SHA256SUMS、.sha256、.md5、.sfv)裡列出的檔案。路徑相對各自的校驗檔解析;不安全的條目會被拒絕。全部相符時回傳真。"
          }
        }
      }
    },
