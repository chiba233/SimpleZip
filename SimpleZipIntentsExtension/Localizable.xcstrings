    "Returns a disk-usage summary for an archive: original vs packed size, compression ratio, macOS junk and the largest file." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liefert eine Speicherübersicht für ein Archiv: Originalgröße vs. gepackt, Kompressionsrate, macOS-Müll und die größte Datei."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Returns a disk-usage summary for an archive: original vs packed size, compression ratio, macOS junk and the largest file."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devuelve un resumen del uso de espacio de un archivo: tamaño original frente a comprimido, ratio de compresión, basura de macOS y el archivo más grande."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renvoie un résumé de l’occupation d’une archive : taille originale vs compressée, taux de compression, fichiers indésirables macOS et le plus gros fichier."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブの容量サマリーを返します:元のサイズと圧縮後サイズ、圧縮率、macOSのゴミ、最大ファイル。"
          }
        },
        "ko" : {
          "stringUnit" : {
