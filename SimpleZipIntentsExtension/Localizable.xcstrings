        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "複数のアーカイブに整合性テストを実行し、すべて合格した場合のみ true を返します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여러 아카이브에 무결성 검사를 실행하고 모두 통과할 때만 true를 반환합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускает проверку целостности нескольких архивов и возвращает true, только если проходят все."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ทดสอบความสมบูรณ์ของไฟล์บีบอัดหลายไฟล์ และคืนค่า true เฉพาะเมื่อผ่านทุกไฟล์"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对多个归档逐个做完整性测试,只有全部通过才返回真。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對多個歸檔逐一做完整性測試,只有全部通過才回傳真。"
          }
        }
      }
    },
    "Runs SimpleZip's integrity test on archives and reports which ones fail. Provide a password for encrypted archives, or you'll be prompted when one is needed." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt SimpleZips Integritätstest für Archive aus und meldet, welche fehlschlagen. Gib für verschlüsselte Archive ein Passwort an – andernfalls wirst du bei Bedarf danach gefragt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs SimpleZip's integrity test on archives and reports which ones fail. Provide a password for encrypted archives, or you'll be prompted when one is needed."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ejecuta la prueba de integridad de SimpleZip en los archivos comprimidos e indica cuáles fallan. Indica una contraseña para los archivos cifrados; si hace falta, se te pedirá."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lance le test d'intégrité de SimpleZip sur les archives et indique celles qui échouent. Fournissez un mot de passe pour les archives chiffrées, sinon il vous sera demandé si nécessaire."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アーカイブに対して SimpleZip の整合性テストを実行し、失敗したものを報告します。暗号化アーカイブにはパスワードを入力してください。必要なときは入力を求められます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아카이브에 SimpleZip의 무결성 테스트를 실행하고 실패한 항목을 보고합니다. 암호화된 아카이브에는 암호를 입력하세요. 필요하면 입력을 요청합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запускает проверку целостности SimpleZip для архивов и сообщает, какие из них не прошли. Укажите пароль для зашифрованных архивов — при необходимости его запросят."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "เรียกใช้การทดสอบความสมบูรณ์ของ SimpleZip กับไฟล์บีบอัดและรายงานว่าไฟล์ใดไม่ผ่าน ระบุรหัสผ่านสำหรับไฟล์ที่เข้ารหัส หรือระบบจะถามเมื่อจำเป็น"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对归档运行 SimpleZip 的完整性测试,并报告哪些未通过。加密归档请填写密码,需要时也会提示你输入。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "對壓縮檔執行 SimpleZip 的完整性測試,並回報哪些未通過。加密壓縮檔請填寫密碼,需要時也會提示你輸入。"
          }
        }
      }
    },
