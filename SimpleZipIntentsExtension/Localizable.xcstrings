{
  "sourceLanguage" : "en",
  "strings" : {
    "A fast, name-only check of a release folder's composition. Returns true when a downloader could verify it (an artifact or container plus SHA256SUMS)." : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine schnelle, rein namensbasierte Prüfung der Zusammensetzung eines Release-Ordners. Gibt „wahr“ zurück, wenn ein Downloader ihn verifizieren könnte (ein Artefakt oder Container plus SHA256SUMS)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fast, name-only check of a release folder's composition. Returns true when a downloader could verify it (an artifact or container plus SHA256SUMS)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprobación rápida, solo por nombre, de la composición de una carpeta de publicación. Devuelve verdadero cuando alguien que la descargue podría verificarla (un artefacto o contenedor más SHA256SUMS)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérification rapide, basée uniquement sur les noms, de la composition d’un dossier de publication. Renvoie vrai si un utilisateur pourrait le vérifier (un artefact ou conteneur plus SHA256SUMS)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リリースフォルダの構成を名前だけで素早く確認します。ダウンロードした人が検証できる状態(成果物またはコンテナ+SHA256SUMS)なら true を返します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "릴리스 폴더 구성을 이름만으로 빠르게 확인합니다. 내려받은 사람이 검증할 수 있으면(산출물 또는 컨테이너 + SHA256SUMS) true를 반환합니다."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Быстрая проверка состава папки релиза только по именам. Возвращает true, если скачавший сможет её проверить (артефакт или контейнер плюс SHA256SUMS)."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ตรวจองค์ประกอบของโฟลเดอร์รีลีสอย่างรวดเร็วโดยดูแค่ชื่อ คืนค่า true เมื่อผู้ดาวน์โหลดสามารถตรวจสอบได้ (มีไฟล์ผลลัพธ์หรือคอนเทนเนอร์ พร้อม SHA256SUMS)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只按文件名快速核对发布目录的组成。当下载者能据此校验(有产物或容器 + SHA256SUMS)时返回真。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只按檔名快速核對發佈目錄的組成。當下載者能據此校驗(有產物或容器 + SHA256SUMS)時回傳真。"
          }
        }
      }
    },
